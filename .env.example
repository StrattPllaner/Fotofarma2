# Llave de API de Google Gemini
# Consigue una en: https://aistudio.google.com/app/apikey
#
# El análisis de recetas se hace directamente desde el navegador, así que la llave
# debe llevar el prefijo VITE_ para que Vite la incluya en la app.
# En producción esta misma variable se configura como secreto de GitHub Actions.
VITE_GEMINI_API_KEY=tu_llave_aiza_aqui
