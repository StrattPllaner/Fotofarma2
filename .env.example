# ---------------------------------------------------------------------------
# FotoFarma — variables de entorno del frontend
# Copia este archivo como .env y llena los valores. .env NUNCA se sube al repo.
# ---------------------------------------------------------------------------

# Dirección del intermediario (Cloudflare Worker) que habla con la IA y con los
# catálogos de farmacias. Es una URL pública: NO es un secreto.
# Se obtiene al desplegar el worker:  cd proxy && npx wrangler deploy
VITE_IA_URL=https://fotofarma-proxy.TU-CUENTA.workers.dev

# (Compatibilidad) Antes se llamaba así; si está puesta, se usa como respaldo.
VITE_PROXY_URL=

# ---------------------------------------------------------------------------
# Lectura de recetas con IA (modo antiguo, directo desde el navegador).
#
# ATENCIÓN: esta llave queda embebida en el JavaScript público, así que solo debe
# usarse una llave SIN facturación (capa gratuita). Lo recomendable es mover la
# lectura de recetas al worker y dejar esta variable vacía.
# La llave del chatbot NO va aquí: vive como secreto del worker (GEMINI_API_KEY).
# ---------------------------------------------------------------------------
VITE_GEMINI_API_KEY=
